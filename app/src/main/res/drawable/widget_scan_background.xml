<?xml version="1.0" encoding="utf-8"?>
<!-- [FIX laporan user, 2026-08-22] "Sudut-sudut widget ganggu"; root
     cause: shape ini punya radius (20dp) + stroke border WARNA KERAS
     sendiri, sementara Android 12+ (API 31+) SUDAH menerapkan clip/mask
     radius sistem-nya SENDIRI di sekeliling widget host (biasanya beda
     angka dari 20dp kita, tergantung launcher); 2 rounding+border yang
     TIDAK match ini menghasilkan sudut ganda/mismatch yang kelihatan
     jelas & ganggu, apalagi stroke warna solid mempertegas selisihnya.
     Fix (API 26-30, fallback file ini): radius diturunkan 20dp->16dp
     (konvensi umum widget non-S+) + stroke DIHAPUS TOTAL (fill polos,
     tidak ada garis tepi keras yang menonjolkan mismatch). Versi API 31+
     ADA file terpisah (drawable-v31/) yang match PERSIS radius sistem;
     lihat file itu utk device modern (S+), fallback ini HANYA berlaku
     API 26-30. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pv_amoled_background" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
