<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- v3.0.0: parent Material (non-light). Dark mode satu-satunya mode
         aplikasi; tidak boleh ada jalur sistem yang diam-diam jatuh ke chrome
         terang. v4.0.0: warna splash ganti ke pv_titanium_base (redesign
         total ke Dark Titanium Neumorphism). -->
    <style name="Theme.PromptVault" parent="android:Theme.Material.NoActionBar" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pv_titanium_base</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PromptVault</item>
    </style>
</resources>
