<?xml version="1.0" encoding="utf-8"?>
<!-- [Fase 3.1 roadmap, 2026-08-21] Layout RemoteViews — HANYA View bawaan
     Android yang didukung RemoteViews (LinearLayout/TextView/dst), TIDAK
     BISA pakai Compose (batasan platform, proses widget terpisah total dari
     Activity, lihat javadoc ScanWidgetProvider.kt). Seluruh area root
     (@id/widget_root) clickable via setOnClickPendingIntent — SENGAJA
     tanpa tombol terpisah, memperbesar target sentuh di widget kecil.
     [Fix cacat "beta testing", 2026-08-21] Root SEBELUMNYA cuma 2 baris teks
     polos tanpa identitas visual apa pun; kelihatan generic/placeholder,
     tidak "branded" sbg widget PromptVault. Dibungkus jadi horizontal: icon
     app (`ic_launcher`, aset yang SUDAH ADA, 0 aset baru) + kolom teks di
     sampingnya, pola umum widget shortcut Android (mis. widget Gmail/Files).

     [AUDIT POLISH 2026-08-21] Temuan: fix di atas TIDAK menutup laporan
     resize/distorsi user sebelumnya (screenshot: teks terpotong/tumpang
     tindih saat widget di-resize kecil) — 2 TextView masih `wrap_content`
     tanpa `maxLines`/`ellipsize` sama sekali, PLUS layout horizontal di atas
     malah mengurangi ruang teks (28dp icon + 10dp margin terpakai duluan).
     Fix: `maxLines="1"` + `ellipsize="end"` di KEDUA TextView — di ukuran
     widget sekecil apa pun, teks panjang dipotong RAPI dgn "…", BUKAN
     terpotong mentah/tumpang tindih. Padding root 14dp->10dp, biar makin
     kecil ambang resize sebelum konten benar-benar kehabisan ruang. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@drawable/widget_scan_background"
    android:padding="10dp">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_scan_label"
            android:textColor="@color/pv_primary_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/widget_scan_action"
            android:textColor="#FFEAEAEA"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
